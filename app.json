{
  "expo": {
    "name": "OpenFrame",
    "slug": "openframe",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openframe",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.openframe.app",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenFrame needs access to your photos to animate them."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "96d31e67-f814-43cc-a7eb-824e91b951e5"
      }
    }
  }
}
